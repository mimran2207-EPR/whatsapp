{
  "name": "resident-comms",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "tokens": "node scripts/build-tokens.mjs",
    "prestart": "npm run tokens",
    "start": "ng serve",
    "prebuild": "npm run tokens",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test:tokens": "node --test scripts/*.test.mjs",
    "test:ui": "npm run tokens && ng test --watch=false",
    "test": "npm run test:tokens && npm run test:ui"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
