{
  // ./public now holds the GENERATED, frontend-only DEMO of the Angular app (in-browser fake API, synthetic data, labelled "דמו").
  // It is committed on purpose (the owner asked to keep the build in the repo). Regenerate it with:
  //   cd src/frontend && npm ci && npm run demo:publish
  // The demo has no backend. The real (non-demo) build is `npm run build` (src/frontend/dist/resident-comms/browser) and is NOT served from here:
  // API hosting is still undecided (ADR, P8), so do not point "directory" at the real build until then.
  "name": "whatsapp",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    // Deep links (/approvals, /campaigns/<id>/tracking, ...) are served the app shell, like a normal SPA host.
    "not_found_handling": "single-page-application"
  },
  // Non-production branches/PRs are built with `npx wrangler preview`, which requires this block (it may be empty).
  "previews": {}
}
